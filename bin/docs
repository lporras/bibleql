#!/usr/bin/env sh
# Serve the documentation site (docs/website) locally.
#
# Default mode builds BOTH locales and serves them from one origin, so the navbar
# language dropdown works and you can click between English and Spanish:
#
#   bin/docs                     # http://localhost:3001/  and  /es/
#   DOCS_PORT=4000 bin/docs
#
# Watch mode gives hot reload, but `docusaurus start` serves only ONE locale per
# process, so pick which one:
#
#   bin/docs --watch                     # English,  http://localhost:3001/
#   DOCS_LOCALE=es bin/docs --watch      # Spanish,  http://localhost:3001/es/
#
# Do not run two watch processes against this directory — they overwrite each
# other's .docusaurus cache and webpack fails with JSON parse errors.

set -e

cd "$(dirname "$0")/../docs/website"

PORT="${DOCS_PORT:-3001}"

if [ ! -d node_modules ]; then
  echo "Installing documentation dependencies (first run only)..."
  npm ci
fi

if [ "$1" = "--watch" ]; then
  shift
  # `npm start` runs prestart first, regenerating the API reference from
  # docs/generated/schema.graphql. Without it a fresh checkout has no
  # docs/api-reference directory and the autogenerated sidebar fails.
  exec npm start -- --port "$PORT" --locale "${DOCS_LOCALE:-en}" "$@"
fi

# `npm run build` runs prebuild (the API reference) and then builds every locale.
npm run build
echo
echo "Docs ready — English at http://localhost:$PORT/ and Spanish at http://localhost:$PORT/es/"
exec npx docusaurus serve --port "$PORT" "$@"
