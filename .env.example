# Copy to .env (gitignored, loaded by dotenv-rails in development and test):
#   cp .env.example .env
# Every variable is optional. Leave a feature's variables empty to turn it off locally.

# --- Database -----------------------------------------------------------------
# Defaults to the local bibleql_development database from config/database.yml.
# DATABASE_URL=postgres://user:password@localhost:5432/bibleql_development

# --- Semantic search (semanticSearch query) -------------------------------------
# Each semanticSearch request embeds the query text through OpenAI (billed to this key).
OPENAI_API_KEY=

# --- Offline translation packages (docs/offline_packages.md) --------------------
# Cloudflare R2 bucket the SQLite packages are uploaded to. All five are required;
# with any missing, exports are refused and imports skip the export step.
#   Account ID:       R2 Object Storage overview → Account Details
#   Access key/secret: R2 → Manage API tokens → Create token (Object Read & Write, this bucket)
#   Public base URL:  bucket → Settings → Public Development URL (https://pub-<hash>.r2.dev)
# Check the setup with: bundle exec rake offline:check_storage
OFFLINE_R2_ACCOUNT_ID=
OFFLINE_R2_ACCESS_KEY_ID=
OFFLINE_R2_SECRET_ACCESS_KEY=
OFFLINE_R2_BUCKET=
OFFLINE_PUBLIC_BASE_URL=

# --- Docs links -----------------------------------------------------------------
# Point the site's documentation links at a local `bin/docs` server instead of docs.bibleql.org.
# DOCS_URL=http://localhost:3001

# --- Email ----------------------------------------------------------------------
# Development opens emails in the browser (letter_opener); these only matter in production.
# RESEND_API_KEY=
# MAILER_FROM_ADDRESS=noreply@bibleql.org
# DEVISE_MAILER_SENDER=noreply@bibleql.org
