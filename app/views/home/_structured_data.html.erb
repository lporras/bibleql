<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "BibleQL",
      "url": "https://bibleql.org",
      "description": "Free, open-source GraphQL Bible API for querying verses, passages, and chapters across multiple translations and languages."
    },
    {
      "@type": "WebAPI",
      "name": "BibleQL GraphQL API",
      "url": "https://bibleql.org/graphql",
      <%# to_json emits the surrounding quotes and escapes <, > and & as \uXXXX,
          which is what keeps this safe to mark html_safe inside a script tag. %>
      "documentation": <%= docs_url.to_json.html_safe %>,
      "description": "A GraphQL API for querying Bible verses, passages, and chapters across <%= site_metric(:translations) %> translations in <%= site_metric(:languages) %> languages.",
      "provider": {
        "@type": "Organization",
        "name": "BibleQL",
        "url": "https://bibleql.org"
      },
      "termsOfService": "https://github.com/lporras/bibleql/blob/main/LICENSE",
      "license": "https://opensource.org/licenses/MIT"
    },
    {
      "@type": "SoftwareApplication",
      "name": "BibleQL",
      "url": "https://bibleql.org",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Free, open-source GraphQL Bible API with <%= site_metric(:translations) %> translations in <%= site_metric(:languages) %> languages."
    }
  ]
}
</script>
