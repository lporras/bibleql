<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bible API Playground | BibleQL</title>
  <meta name="description" content="Interactive GraphQL playground for the BibleQL Bible API. Test queries for verses, passages, and chapters across 43+ translations.">
  <link rel="canonical" href="https://bibleql.org/playground">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/graphiql@3.8.3/graphiql.min.css">
  <style>
    body { margin: 0; height: 100vh; }
    #graphiql { height: 100vh; }
  </style>
</head>
<body>
  <div id="graphiql"></div>

  <script src="https://cdn.jsdelivr.net/npm/react@18.3.1/umd/react.production.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/react-dom@18.3.1/umd/react-dom.production.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/graphiql@3.8.3/graphiql.min.js"></script>

  <% default_query = <<~GRAPHQL
# Welcome to BibleQL API Playground!
#
# A GraphQL API for querying Bible verses and passages
# across 47 translations in 31 languages.
#
# Supported reference formats:
#   "John 3:16"              \u2014 single verse
#   "John 3:16-18"           \u2014 verse range
#   "Matthew 25:31-33,46"    \u2014 multiple ranges
#   "Genesis 1"              \u2014 full chapter
#   "Mateo 28:18-20"         \u2014 localized book names
#
# Every example below is a named operation, so they can all stay uncommented.
# Pick which one to run from the dropdown on the \u25b6 execute button, or click
# the \u25b6 in the gutter next to the operation you want.

query LookupPassage {
  passage(translation: "eng-web", reference: "John 3:16") {
    reference
    text
    translationName
    translationNote
    verses {
      bookId
      bookName
      chapter
      verse
      text
    }
  }
}

query LookupPassageInSpanish {
  passage(translation: "spa-bes", reference: "Mateo 28:18-20") {
    reference
    text
    translationName
    verses { bookName chapter verse text }
  }
}

query MultipleVerseRanges {
  passage(reference: "Matthew 25:31-33,46") {
    reference
    text
    verses { chapter verse text }
  }
}

query FullChapter {
  chapter(book: "GEN", chapter: 1) {
    bookName
    chapter
    verse
    text
  }
}

query SingleVerse {
  verse(book: "JHN", chapter: 3, verse: 16) {
    bookName
    chapter
    verse
    text
  }
}

query SearchVerses {
  search(query: "love", limit: 10) {
    bookName
    chapter
    verse
    text
  }
}

query RandomVerse {
  randomVerse(translation: "spa-bes") {
    bookName
    chapter
    verse
    text
  }
}

query RandomVerseFromNewTestament {
  randomVerse(testament: "NT") {
    bookName
    chapter
    verse
    text
  }
}

query RandomVerseFromBooks {
  randomVerse(books: "PSA,PRO") {
    bookName
    chapter
    verse
    text
  }
}

query SemanticSearch {
  semanticSearch(query: "fe y esperanza", limit: 5) {
    verse {
      bookName
      chapter
      verse
      text
    }
    similarity
  }
}

query VerseOfTheDay {
  verseOfTheDay(translation: "eng-web") {
    reference
    text
    translationName
    verses { bookName chapter verse text }
  }
}

query ListTranslations {
  translations {
    identifier
    name
    abbrev
    language
    languageName
    note
  }
}

query GetTranslation {
  translation(identifier: "spa-nvi") {
    identifier
    name
    abbrev
    language
    languageName
    note
  }
}

query ListLanguages {
  languages {
    code
    translationCount
    translations { identifier name abbrev }
  }
}

query ListBooks {
  books {
    bookId
    name
    testament
    position
  }
}

query BibleIndex {
  bibleIndex(translation: "eng-web") {
    bookId
    name
    chapterCount
    chapters { number verseCount }
  }
}
  GRAPHQL
  playground_version = Digest::SHA256.hexdigest(default_query)[0, 12]
  %>

  <script>
    const fetcher = GraphiQL.createFetcher({
      url: <%= raw graphql_url.to_json %>,
    });

    const defaultQuery = <%= raw default_query.to_json %>;

    const defaultHeaders = JSON.stringify({
      "Authorization": "Bearer YOUR_API_KEY"
    }, null, 2);

    // GraphiQL persists the editor's query/tabs to localStorage and restores
    // them on every load, ignoring defaultQuery once anything has been saved.
    // Bumping PLAYGROUND_VERSION (tied to the example queries above) clears
    // that stale state so returning visitors see updates without needing
    // an incognito window or a manual cache/cookie clear.
    (function resetStalePlaygroundState() {
      const PLAYGROUND_VERSION = <%= raw playground_version.to_json %>;
      try {
        if (window.localStorage.getItem("bibleql:playgroundVersion") !== PLAYGROUND_VERSION) {
          Object.keys(window.localStorage)
            .filter((key) => key.startsWith("graphiql"))
            .forEach((key) => window.localStorage.removeItem(key));
          window.localStorage.setItem("bibleql:playgroundVersion", PLAYGROUND_VERSION);
        }
      } catch (e) {
        // localStorage may be unavailable (e.g. privacy mode); nothing to do.
      }
    })();

    ReactDOM.render(
      React.createElement(GraphiQL, {
        fetcher: fetcher,
        defaultQuery: defaultQuery,
        defaultHeaders: defaultHeaders,
        headerEditorEnabled: true,
      }),
      document.getElementById('graphiql'),
    );
  </script>
</body>
</html>
