# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore code coverage output
/coverage/

.DS_Store

# Holy-Bible-XML-Format translations (see docs/holy-bible-xml-identifiers.md) are
# downloaded here by hand, one file at a time, for local/offline import — never a
# git submodule (Render syncs every registered submodule on deploy, so a 1000+
# file source can't be one) and never committed to this repo.
/db/holy-bible-xml/*
!/db/holy-bible-xml/.gitkeep

# Documentation site (docs/website). Note docs/generated/schema.graphql IS
# committed — CI verifies it against app/graphql — but everything derived from it
# is rebuilt on every build by `npm run build`.
/docs/website/node_modules/
/docs/website/build/
/docs/website/.docusaurus/
/docs/website/.env.local
# Generated from docs/generated/schema.graphql by `docusaurus graphql-to-doc`.
/docs/website/docs/api-reference/
